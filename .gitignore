# Ignore Jupyter Notebooks and Lab files
*.ipynb
.ipynb_checkpoints/

# Ignore Python cache and system files
__pycache__/
*.pyc
.env
.venv/
env/

# Ignore your local databases and memory
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite-wal

# Ignore the local sandbox (Hugging Face will make its own)
sandbox/

# Ignore accidental OS files
.DS_Store
Thumbs.db